{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graphite Mail",
  "version": "1.4.1",
  "identifier": "com.fasi747.graphitemail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Graphite Mail",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Faisal Gillani",
    "category": "Productivity",
    "shortDescription": "Offline-first Microsoft 365 mail & calendar for Linux",
    "longDescription": "Graphite Mail is a free, open-source mail and calendar client for Microsoft 365. Read, search, reply and plan offline; changes sync when you reconnect. You choose where your mail is stored.",
    "linux": {
      "deb": {
        "section": "mail",
        "priority": "optional",
        "recommends": [
          "gnome-keyring | kwalletmanager"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
